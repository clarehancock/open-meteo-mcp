{
  "name": "open-meteo-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping the Open-Meteo weather and geocoding APIs (no API key required)",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "open-meteo-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}